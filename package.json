{
  "name": "qcm-systeme",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:test": "next dev --port 3001",
    "dev:e2e": "bun --env-file=.env.test run dev:test",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "bun run scripts/db-setup.ts",
    "db:ping": "bun --env-file=.env.local run scripts/db-ping.ts",
    "db:migrate": "bun --env-file=.env.local run scripts/migrate.ts",
    "db:seed": "bun --env-file=.env.local run scripts/seed.ts",
    "db:reset": "bun --env-file=.env.local run scripts/db-reset.ts",
    "db:import": "bun --env-file=.env.local run scripts/import-questions.ts",
    "db:bulk-import": "bun --env-file=.env.local run scripts/bulk-import.ts",
    "db:approve": "bun run scripts/approve-by-confidence.ts",
    "generate": "bun run scripts/generate_questions.ts",
    "validate": "bun run scripts/validate_questions.ts",
    "export-diagrams": "bun run scripts/export-diagrams.ts",
    "magic-link": "bun --env-file=.env.local run scripts/generate-magic-link.ts",
    "create-enseignant": "bun --env-file=.env.local run scripts/create-enseignant.ts",
    "create-admin-ped": "bun --env-file=.env.local run scripts/create-admin-ped.ts",
    "seed:test": "bun --env-file=.env.test run scripts/seed-test-data.ts",
    "test": "bun --env-file=.env.test test tests/api",
    "test:watch": "bun --env-file=.env.test test --watch tests/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^25.6.0",
    "next": "^16.2.4",
    "postgres": "^3.4.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3"
  }
}
