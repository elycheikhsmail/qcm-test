@startuml UC_Directeur
left to right direction
skinparam actorStyle awesome

actor "Directeur" as DIR

rectangle "Espace Directeur" {
  usecase "Consulter ses classes assignées" as UC1
  usecase "Voir les stats globales d'une classe" as UC2
  usecase "Voir le détail d'un test" as UC3
  usecase "Consulter le profil d'un élève" as UC4
  usecase "Analyser l'évolution d'un élève" as UC5
  usecase "Visualiser les graphiques de performance" as UC6
}

DIR --> UC1
DIR --> UC2
DIR --> UC4

UC1 .> UC2 : <<include>>
UC2 .> UC3 : <<extend>>
UC2 .> UC6 : <<include>>
UC4 .> UC5 : <<include>>

@enduml
