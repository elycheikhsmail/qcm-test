# Copier en .env.local et remplir
# URL de connexion PostgreSQL (format postgres.js)
DATABASE_URL=postgres://qcm_app:qcm_dev_password@localhost:5432/qcm_db

# Clé API Anthropic pour le pipeline pédagogique (scripts/generate_questions.ts)
ANTHROPIC_API_KEY=sk-ant-...

# Jeton d'admin pour les routes protégées (S4)
# Envoyé via en-tête `X-Admin-Token: <valeur>` sur POST /api/magic-links
ADMIN_TOKEN=dev_admin_token_change_me

# Google OAuth (Sprint 11)
# Créer un projet GCP → OAuth 2.0 Client ID → URI autorisé : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publique de l'app (dev = http://localhost:3000)
APP_URL=http://localhost:3000
